# Supabase Settings -> API. Keep this secret on Render; do not put it in the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact origins. Add the production frontend URL after it is deployed.
CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development

# Bright Data (https://brightdata.com -> Account settings -> API tokens).
# Used by the discovery pipeline only, never by the browser. Leave blank and
# the pipeline skips discovery instead of failing.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api1
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1
# Hard stop on billable requests per run.
BRIGHT_DATA_MAX_REQUESTS=200

# OpenAI, for turning fetched pages into structured claims. A claim is
# discarded unless its quote is found verbatim in the page, so the cheap tier
# is enough.
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
