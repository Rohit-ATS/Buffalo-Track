# Supabase Settings -> API. Keep this secret on Render; do not put it in the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact origins. Add the production frontend URL after it is deployed.
CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development

# Public-search admission control. Render keeps this service at one instance.
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=60
SEARCH_MAX_CONCURRENCY=8

# Generate with `openssl rand -hex 32`. Set the identical value, without a
# VITE_ prefix, in the frontend server environment as BACKEND_PROXY_SECRET.
BACKEND_PROXY_SECRET=

# Bright Data (https://brightdata.com -> Account settings -> API tokens).
# Used by the discovery pipeline only, never by the browser. Leave blank and
# the pipeline skips discovery instead of failing.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api1
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1
# Hard stop on billable requests per run.
BRIGHT_DATA_MAX_REQUESTS=200

# Anthropic, for turning fetched pages into structured claims. The model only
# reads and copies, and anything it invents is discarded by the quote verifier,
# so the cheapest current model is the right one.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5
