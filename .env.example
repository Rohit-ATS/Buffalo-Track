# Supabase project (Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Embedding model dimension must match evidence.embedding in 0001_init.sql
EMBEDDING_DIM=1536

# The frontend reads its own server-only credentials from frontend/.env
# (see frontend/.env.example) — SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
