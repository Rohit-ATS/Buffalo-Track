# Public FastAPI service URL. It is safe to expose because the service-role key
# remains only on the backend; the API enforces its own IP rate limit.
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# Only needed when the frontend is deployed with a server runtime. GitHub Pages
# uses the public VITE_BACKEND_URL path and does not need this secret.
BACKEND_PROXY_SECRET=

# Without these, search falls back to the curated sample path on the landing page.

# Client-side, for live graph updates (src/hooks/use-realtime-graph.ts).
# Safe to expose to the browser: RLS restricts the anon key to SELECT only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
