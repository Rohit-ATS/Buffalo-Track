# Server-only Supabase credentials for the frontend's atlas search.
#
# RLS is enabled with no policies, so the anon key reads nothing — the search
# server function uses the service-role key, which bypasses RLS. Never expose
# this key to the browser and never prefix it with VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Without these, search falls back to the curated sample path on the landing page.

# Client-side, for live graph updates (src/hooks/use-realtime-graph.ts).
# Safe to expose to the browser: RLS restricts the anon key to SELECT only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
