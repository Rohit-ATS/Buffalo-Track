# Preferred production path: FastAPI service URL. When set, search goes through
# the backend; keep this unprefixed because it is read only by a server function.
BACKEND_URL=http://localhost:8000

# Without these, search falls back to the curated sample path on the landing page.

# Client-side, for live graph updates (src/hooks/use-realtime-graph.ts).
# Safe to expose to the browser: RLS restricts the anon key to SELECT only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
